@prefix dct:    <http://purl.org/dc/terms/> .
@prefix ui:     <http://www.w3.org/ns/ui#> .
@prefix schema: <http://schema.org/> .

<>
  a ui:Plugin ;
  schema:additionalType ui:Component ;
  ui:label "Fediverse" ;
  ui:icon "🐘" ;
  schema:url </dk-pod/dk/plugins/fediverse/dk-fediverse.js> ;
  schema:description "Follow, read, and post on the fediverse (Mastodon and friends) from your pod." ;
  dct:publisher "Jeff Zucker" ;
  schema:keywords "Other Services" ;
  schema:additionalProperty
    [ schema:name "source" ; schema:value "/dk-pod/fediverse/timeline/" ] .
