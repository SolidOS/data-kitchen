@prefix :      <#>.
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#>.
@prefix schema: <http://schema.org/>.
@prefix ui:    <http://www.w3.org/ns/ui#>.
@prefix web:   </node_modules/sol-components/web/>.
@prefix menu:  <data-kitchen-main-menu.ttl#>.

# dk's shell layout, source-of-truth for index.html's BODY region tree
# (nav + main). The <head> (importmap, module loader, CSP, stylesheets), the
# skip-link, and the <sol-default> preferences singleton are shell SCAFFOLDING,
# not layout — they stay hand-authored in index.html and are NOT modelled here.
#
# dk is a native application (Electron desktop + Android), NOT a web app —
# hence schema:SoftwareApplication, not schema:WebApplication (which is for the
# standalone WEB apps the layout compiler was built to generate). The renderer
# is a web document, but the shipped artifact is a native host.

:DataKitchen a schema:SoftwareApplication ;
    schema:name "Data Kitchen" ;
    ui:layout :Shell .

# The shell stacks vertically: the control bar on top, the content below.
:Shell a ui:Layout ;
    ui:label "dk shell" ;
    ui:orientation ui:Vertical ;
    schema:itemListElement
        [ a schema:ListItem ; schema:item :ChromeBar ; schema:position 1 ] ,
        [ a schema:ListItem ; schema:item :Content   ; schema:position 2 ] ,
        [ a schema:ListItem ; schema:item :MenuPane  ; schema:position 3 ] .

# The control bar — <nav aria-label="Controls"> — carrying the mini-player.
# (#Bar / #Chrome are injected INTO the tabset at runtime by dk-tabs-rdf.js,
# so they are not layout siblings here; the tabset is an opaque leaf.)
# The ARIA `role` names the element (navigation → <nav>); the native <nav>
# carries the role implicitly, so no role= attribute is emitted.
:ChromeBar a ui:Layout ;
    schema:additionalProperty
        [ schema:name "role"       ; schema:value "navigation" ] ,   # → <nav>
        [ schema:name "class"      ; schema:value "omp-chrome-bar" ] ,
        [ schema:name "aria-label" ; schema:value "Controls" ] ;
    schema:itemListElement
        [ a schema:ListItem ; schema:item :MiniPlayer ; schema:position 1 ] .

:MiniPlayer a ui:Component ;
    schema:url web:sol-include.js ;                               # tag → <sol-include>
    schema:additionalProperty
        [ schema:name "source"  ; schema:value "dk-pod/dk/plugins/ia-player/assets/mini-player.html" ] ,
        [ schema:name "trusted" ; schema:value "" ] .

# The primary content region — role="main" → <main>, declared explicitly (no
# reliance on positional "first unmarked region" magic). Holds ONLY the tabset
# leaf; the menu-pane is a sibling AFTER it (role-less → <div>).
:Content a ui:Layout ;
    ui:orientation ui:Vertical ;
    schema:additionalProperty
        [ schema:name "role"     ; schema:value "main" ] ,           # → <main>
        [ schema:name "id"       ; schema:value "dk-content" ] ,
        [ schema:name "class"    ; schema:value "omp-panels" ] ,
        [ schema:name "tabindex" ; schema:value "-1" ] ;
    schema:itemListElement
        [ a schema:ListItem ; schema:item :Tabs ; schema:position 1 ] .

# The tabset — a leaf whose tag is sol-tabs; from-rdf points it at the #Tabs
# menu (still runtime-rendered, so menu edits need no shell regeneration).
:Tabs a ui:Component ;
    rdfs:comment "Topmost tabset; tabs come from data-kitchen-main-menu.ttl#Tabs at runtime (menu-from-rdf), #Bar/#Chrome injected by src/dk-tabs-rdf.js. data-settings-skip keeps its editor out of the Customize accordion." ;
    schema:url web:sol-tabs.js ;                                  # tag → <sol-tabs>
    schema:additionalProperty
        [ schema:name "id"        ; schema:value "dk-tabs" ] ,
        [ schema:name "keep-alive" ; schema:value "" ] ,
        [ schema:name "from-rdf"  ; schema:value "./dk-pod/dk/ui-data/data-kitchen-main-menu.ttl#Tabs" ] ,
        [ schema:name "data-settings-skip" ; schema:value "" ] .

# The ☰-menu landing pane — a role-less region → <div>. Its authored position
# (a sibling after :Content, vs. inside it as the old hand-written shell had it)
# is invisible: dk-tabs-shell re-homes it into the tabset's content at runtime.
# Customize / Settings mount here via data-for.
:MenuPane a ui:Layout ;
    rdfs:comment "The ☰ menu's items (claimed by data-for) display here while open; dk-tabs-shell re-homes it into the tabset at runtime." ;
    schema:additionalProperty
        [ schema:name "id"       ; schema:value "dk-menu-pane" ] ,
        [ schema:name "class"    ; schema:value "dk-menu-pane" ] ,
        [ schema:name "data-for" ; schema:value "Customize Settings" ] ,
        [ schema:name "hidden"   ; schema:value "" ] .
